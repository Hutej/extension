{
  "name": "revueon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "node --experimental-strip-types scripts/audit-env.ts && node --experimental-strip-types scripts/audit-wiring.ts && wxt build",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests — use the harness: node --experimental-strip-types tests/harness.ts'",
    "test:e2e": "node --experimental-strip-types tests/harness.ts",
    "prove": "node --experimental-strip-types scripts/prove.ts",
    "lint": "eslint src/ --ext .ts",
    "audit:wiring": "node --experimental-strip-types scripts/audit-wiring.ts",
    "audit:env": "node --experimental-strip-types scripts/audit-env.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "playwright": "^1.61.1",
    "typescript": "^5.8.3",
    "wxt": "^0.20.6"
  }
}
