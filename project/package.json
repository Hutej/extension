{
  "name": "revueon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "node --experimental-strip-types scripts/audit-imports.ts && wxt build",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "audit:imports": "node --experimental-strip-types scripts/audit-imports.ts",
    "test": "node --experimental-strip-types scripts/test-gate.ts",
    "test:unit": "node --experimental-strip-types scripts/test-gate.ts --unit",
    "test:browser": "node --experimental-strip-types scripts/test-gate.ts --browser",
    "test:stress": "node --test --test-concurrency=1 --experimental-strip-types tests/stress/stress.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.2",
    "@types/css-tree": "3.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "playwright": "^1.61.1",
    "typescript": "^5.8.3",
    "wxt": "^0.20.6"
  },
  "dependencies": {
    "css-tree": "3.2.1"
  }
}
